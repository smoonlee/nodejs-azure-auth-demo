    "helmet": "8.1.0",
    "morgan": "^1.10.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^4.0.17",
    "tslib": "^2.6.2",
